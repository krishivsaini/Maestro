# --- Maestro environment ---
# Copy to `.env` and fill in. Never commit `.env`.

# Gemini free tier (primary LLM). Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional web-search provider key (only if using a keyed provider such as Tavily/SerpAPI).
# The default provider is DuckDuckGo, which needs no key.
SEARCH_API_KEY=

# --- Optional overrides (defaults live in maestro/config.py) ---
# All Maestro settings can be overridden with the MAESTRO_ prefix, e.g.:
# MAESTRO_MODEL_ID=gemini-3.5-flash-lite
# MAESTRO_MAX_PARALLEL=2
# MAESTRO_MAX_CRITIC_ITERS=3
# MAESTRO_FAULT_INJECTION=false          # set true to demo visible recovery
# MAESTRO_FAULT_INJECTION_TOOL=web_search
# MAESTRO_FOLLOWUP_GUARD=true          # refuse follow-ups unrelated to the thread's research
# MAESTRO_CRITIC_MODEL_ID=              # review on another model (empty = the run's own)
# MAESTRO_CRITIC_MAJOR_LIMIT=2          # open major issues that send a draft back
# MAESTRO_MAX_REPLANS=1                 # extra research rounds the critic can trigger per run

# --- Deployment ---
# DATABASE_URL=postgresql://...          # durable runs + memory (e.g. a free Neon project)
# MAESTRO_RUN_LIMIT_PER_IP=6             # runs per visitor per hour on the shared key (0 = off)
# MAESTRO_SHARED_DAILY_RUNS=60           # runs per UTC day on the shared key, all visitors (0 = off)
# MAESTRO_TRUST_PROXY=false              # true only behind a proxy that sets X-Forwarded-For
# MAESTRO_MEMORY_EMBEDDER=gemini        # recall by meaning (Gemini embeddings); "hashing" = by words, no API call
# MAESTRO_PRICE_INPUT_PER_MILLION=0      # USD per 1M input tokens, to show a cost estimate per run
# MAESTRO_PRICE_OUTPUT_PER_MILLION=0
